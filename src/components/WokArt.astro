---
// Flat vector emblem: a wok erupting in flame, tossed ingredients, steam.
// Geometry only (no shading, no perspective). Every shape is specified here.
// Animated by CSS (flame flicker, steam) and GSAP (ignite, toss loops).

const flame = (x, base, w, h, lean = 0) =>
  `M${x - w} ${base} C${x - w} ${base - h * 0.38} ${x - w * 0.25 + lean * 0.3} ${base - h * 0.62} ${x + lean} ${base - h} ` +
  `C${x + w * 0.3 + lean * 0.4} ${base - h * 0.6} ${x + w} ${base - h * 0.36} ${x + w} ${base} Z`;

// [x, width, height, lean, flicker duration, flicker delay]
const tongues = [
  [320, 72, 222, 14, 1.15, 0],
  [238, 58, 168, -30, 0.95, 0.2],
  [406, 58, 174, 32, 1.05, 0.4],
  [172, 44, 112, -28, 0.85, 0.1],
  [470, 44, 120, 30, 0.9, 0.55],
];
const base = 238;

// Jets under the wok: the blue base of a gas burner
const jets = Array.from({ length: 9 }, (_, i) => 206 + i * 27);

// Tossed ingredients: [kind, x, y]
const toss = [
  ['scallion', 196, 118],
  ['scallion', 452, 96],
  ['scallion', 362, 52],
  ['scallion', 286, 84],
  ['chilli', 138, 176],
  ['chilli', 502, 150],
  ['chilli', 330, 120],
  ['momo', 108, 84],
  ['momo', 526, 66],
  ['noodle', 232, 40],
  ['noodle', 410, 134],
  ['sesame', 160, 130],
  ['sesame', 244, 150],
  ['sesame', 380, 30],
  ['sesame', 430, 188],
  ['sesame', 478, 112],
  ['sesame', 300, 28],
];
---

<svg
  class="wok"
  viewBox="-20 0 680 560"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <!-- Steam: aroma rising off the rim, left and right of the flame -->
  <g class="wok__steam" fill="none" stroke="#fbf6e8" stroke-width="9" stroke-linecap="round">
    <path class="steam" style="--sd: 0s" d="M118 196c-20-26 20-46 0-74s20-48 0-76" />
    <path class="steam" style="--sd: 0.9s" d="M82 184c-16-22 16-40 0-62s16-40 0-62" />
    <path class="steam" style="--sd: 0.4s" d="M522 196c20-26-20-46 0-74s-20-48 0-76" />
    <path class="steam" style="--sd: 1.3s" d="M560 184c16-22-16-40 0-62s-16-40 0-62" />
  </g>

  <!-- Flame erupting from the wok mouth (behind the front lip) -->
  <g class="wok__flames">
    {
      tongues.map(([x, w, h, lean, dur, delay]) => (
        <g class="flame" style={`--fd: ${dur}s; --fl: ${delay}s`}>
          <path class="flame__shape" fill="var(--flame-red)" d={flame(x, base, w, h, lean)} />
          <path
            class="flame__shape"
            fill="var(--flame-orange)"
            d={flame(x, base, w * 0.7, h * 0.74, lean * 0.7)}
          />
          <path
            class="flame__shape"
            fill="var(--flame-yellow)"
            d={flame(x, base, w * 0.42, h * 0.46, lean * 0.45)}
          />
        </g>
      ))
    }
  </g>

  <!-- Wok interior and heaped food -->
  <ellipse cx="320" cy="232" rx="252" ry="36" fill="#0e0a08" />
  <path d="M96 238C130 172 230 152 320 158C410 152 510 172 544 238Z" fill="#b45a14" />
  <g fill="none" stroke="#e08a2b" stroke-width="7" stroke-linecap="round">
    <path d="M128 222C168 192 226 186 268 198" />
    <path d="M300 186C346 176 404 184 452 204" />
    <path d="M176 232C230 214 300 214 360 222" />
    <path d="M400 226C440 218 486 218 520 230" />
  </g>
  <g fill="none" stroke="#2e8b3e" stroke-width="5">
    <circle cx="210" cy="206" r="8" />
    <circle cx="352" cy="192" r="8" />
    <circle cx="470" cy="214" r="8" />
    <circle cx="150" cy="232" r="7" />
  </g>
  <g fill="none" stroke="var(--chilli)" stroke-width="7" stroke-linecap="round">
    <path d="M250 214q10-6 20 2" />
    <path d="M420 200q10-6 20 2" />
  </g>

  <!-- Wok body: front lip, bowl, highlight, handles -->
  <path
    d="M68 232A252 36 0 0 0 572 232C556 342 436 412 320 412C204 412 84 342 68 232Z"
    fill="#1d1512"
  />
  <path
    d="M104 292C142 352 212 384 272 394"
    fill="none"
    stroke="#43332b"
    stroke-width="7"
    stroke-linecap="round"
  />
  <path
    d="M68 232A252 36 0 0 0 572 232"
    fill="none"
    stroke="#54423a"
    stroke-width="9"
    stroke-linecap="round"
  />
  <g class="wok__handle">
    <rect x="-24" y="204" width="106" height="22" rx="11" transform="rotate(16 70 232)" fill="#8a4b24" />
    <rect x="58" y="222" width="26" height="20" rx="4" transform="rotate(16 70 232)" fill="#54423a" />
  </g>
  <path
    d="M570 224q44-10 48 12q2 22-46 14"
    fill="none"
    stroke="#1d1512"
    stroke-width="9"
    stroke-linecap="round"
  />

  <!-- Gas burner: blue jets, ring, stove top -->
  <g class="wok__jets">
    {
      jets.map((x, i) => (
        <g class="jet" style={`--jd: ${0.5 + (i % 3) * 0.12}s; --jl: ${(i % 4) * 0.07}s`}>
          <path fill="var(--gas-blue)" d={flame(x, 442, 9, 30, 0)} />
          <path fill="#e3f0ff" d={flame(x, 442, 4, 14, 0)} />
        </g>
      ))
    }
  </g>
  <path d="M146 486L494 486L454 440L186 440Z" fill="#2c201b" />
  <rect x="104" y="486" width="432" height="22" rx="6" fill="#1b1310" />

  <!-- Tossed ingredients (their loops are driven by GSAP) -->
  <g class="wok__toss">
    {
      toss.map(([kind, x, y]) => (
        <g class="toss" data-toss data-y={y} data-kind={kind} transform={`translate(${x} ${y})`}>
          <g class="toss__inner">
            {kind === 'scallion' && (
              <circle r="9" fill="none" stroke="#2e8b3e" stroke-width="5" />
            )}
            {kind === 'chilli' && (
              <path d="M-11 4q10-12 22-2" fill="none" stroke="var(--chilli)" stroke-width="8" stroke-linecap="round" />
            )}
            {kind === 'momo' && (
              <g>
                <path d="M-20 8a20 15 0 0 1 40 0Z" fill="#fbf6e8" stroke="#1b1310" stroke-width="3" stroke-linejoin="round" />
                <path d="M-10 8l3-9M0 8v-11M10 8l-3-9" stroke="#1b1310" stroke-width="2.5" stroke-linecap="round" fill="none" />
              </g>
            )}
            {kind === 'noodle' && (
              <path d="M-16 0c8-14 16 14 32 0" fill="none" stroke="#e08a2b" stroke-width="7" stroke-linecap="round" />
            )}
            {kind === 'sesame' && <ellipse rx="5" ry="3" fill="#fbf6e8" stroke="#1b1310" stroke-width="1.5" />}
          </g>
        </g>
      ))
    }
  </g>
</svg>

<style is:global>
  .wok {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* .flame and .toss__inner are driven by GSAP; the shapes inside animate in CSS */
  .flame__shape {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: flicker var(--fd, 1s) ease-in-out var(--fl, 0s) infinite;
  }
  .jet {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: jet var(--jd, 0.6s) ease-in-out var(--jl, 0s) infinite;
  }
  .steam {
    stroke-dasharray: 78 46;
    animation:
      steam-flow 3.6s linear var(--sd, 0s) infinite,
      steam-fade 3.6s ease-in-out var(--sd, 0s) infinite;
  }
  @keyframes flicker {
    0%,
    100% {
      transform: scale(1, 1) skewX(0deg);
    }
    30% {
      transform: scale(0.95, 1.07) skewX(2.5deg);
    }
    62% {
      transform: scale(1.04, 0.94) skewX(-2deg);
    }
  }
  @keyframes jet {
    0%,
    100% {
      transform: scaleY(1);
    }
    50% {
      transform: scaleY(0.8);
    }
  }
  @keyframes steam-flow {
    to {
      stroke-dashoffset: -124;
    }
  }
  @keyframes steam-fade {
    0%,
    100% {
      opacity: 0.2;
    }
    50% {
      opacity: 0.75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flame__shape,
    .jet,
    .steam {
      animation: none;
    }
    .steam {
      opacity: 0.45;
    }
  }
</style>
