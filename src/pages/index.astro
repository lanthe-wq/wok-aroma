---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Statement from '../components/Statement.astro';
import RateList from '../components/RateList.astro';
import Combos from '../components/Combos.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import { site } from '../config/site.js';

const title = `${site.name} · ${site.tagline} · ${site.address.locality}, ${site.address.city}`;
const description = `${site.name} at ${site.address.building}, ${site.address.locality}, ${site.address.city}: momos, noodles, fried rice, manchurian and more. ${site.hours.summary}. Free home delivery up to ${site.delivery.freeWithinKm} km. Call ${site.phone.display}.`;
---

<Base title={title} description={description}>
  <Preloader />
  <a class="skip" href="#main">Skip to the content</a>
  <Nav />

  <div class="curtain" data-curtain>
    <main id="main">
      <Hero />
      <Marquee />
      <Statement />
      <RateList />
      <Combos />
      <Visit />
    </main>
  </div>

  <Footer />
  <ActionBar />

  <script>
    import '../scripts/main.js';
  </script>
</Base>
