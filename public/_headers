# Cache rules for Netlify and Cloudflare Pages (same syntax). Other hosts need the
# equivalent; see "Caching" in the README.

# Build output is named by a hash of its contents: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Font URLs carry ?v=<hash of the file> (see src/layouts/Base.astro): same.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The page revalidates on every visit, so a deploy shows up straight away.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# These keep their names between deploys: a moderate lifetime.
/og.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-*.png
  Cache-Control: public, max-age=604800
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
