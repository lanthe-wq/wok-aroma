---
// Four studs for the corners of a plate. The parent must be position: relative.
const { bolt = false } = Astro.props;
---

<span class:list={['studs', { 'studs--bolt': bolt }]} aria-hidden="true">
  <i class="stud stud--tl"></i>
  <i class="stud stud--tr"></i>
  <i class="stud stud--bl"></i>
  <i class="stud stud--br"></i>
</span>
